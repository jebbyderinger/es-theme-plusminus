<?xml version="1.0" encoding="UTF-8"?>
<theme>
  <formatVersion>7</formatVersion>
	<view name="system">
		<carousel name="systemcarousel">
			<visible>false</visible>
			<type>vertical_wheel</type>
			<logoScale>0</logoScale>
			<pos>0 0</pos>
			<size>0 0</size>
		</carousel>
	<image name="logo1" region="eu" extra="static"></image>
        <image name="logo1" region="us" extra="static">
            <path>./../../_inc/logos/us/${system.theme}.png</path>
            <path>./../../_inc/logos/us/${system.theme}.svg</path>
        </image>
        <image name="logo1" region="jp" extra="static">
            <path>./../../_inc/logos/jp/${system.theme}.png</path>
            <path>./../../_inc/logos/jp/${system.theme}.svg</path>
        </image>
        <image name="logo1" extra="static">
            <path>./../../_inc/logos/${system.theme}-w.svg</path>
            <path>./../../_inc/logos/${system.theme}-w-${lang}.png</path>
            <path>./../../_inc/logos/${system.theme}-w-${lang}.svg</path>
            <path>./../../_inc/logos/${system.theme}.png</path>
            <path>./../../_inc/logos/${system.theme}.svg</path>	
            <path>./../../_inc/logos/${system.theme}-${lang}.png</path>
            <path>./../../_inc/logos/${system.theme}-${lang}.svg</path>
            <linearSmooth>true</linearSmooth>
            <zIndex>175</zIndex>
            <pos>0.5 0.45</pos>
            <maxSize>0.78 0.5</maxSize>
            <origin>0.5 0.5</origin>
            <storyboard>
                <animation property="scale" from="1" to="1.05" begin="100" duration="2000" mode="easeOut"/>
                <animation property="scale" from="1.05" to="1.1" begin="2000" duration="400" mode="easeOut"/>
                <animation property="opacity" from="1" to="0.4" begin="500" duration="1500" mode="easeOut"/>
                <animation property="opacity" from="0.4" to="0" begin="2000" duration="400" mode="easeOut"/>
            </storyboard>
        </image>
	</view>
</theme>
