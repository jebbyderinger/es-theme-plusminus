<?xml version="1.0" encoding="UTF-8"?>

<theme defaultView="Colorful + Gamelist (vertically)">
<formatVersion>7</formatVersion>
	<view name="basic">
		<text name="logoText">
			<pos>0.5 0.1427777777777778</pos>
			<origin>0.5 0</origin>
			<size>0.15625 0.0555555555555556</size>
			<fontSize>0.0444444444444444</fontSize>
			<fontPath>./../../_inc/fonts/ubuntu_condensed.ttf</fontPath>
			<color>${baseColor}</color>
			<forceUppercase>true</forceUppercase>
		</text>
		<image name="background" extra="true">
			<tile>true</tile>
			<origin>0.5 0.5</origin>
			<pos>0.5 0.5</pos>
			<size>1 1</size>
			<path>./../../_inc/images/space.png</path>
			<color>141414</color>
		</image>
		<image name="ArrowBG" extra="static">
			<zIndex>175</zIndex>
			<color>141414</color>
			<path>./../../_inc/images/arrow_bg.jpg</path>
			<path>./../../_inc/images/arrow_bg.png</path>
			<pos>0.98 0.018</pos>
			<maxSize>0.04</maxSize>
			<origin>0.5 0.5</origin>
		</image>
		<image name="ArrowUp" extra="static">
			<zIndex>175</zIndex>
			<color>666666</color>
			<path>./../../_inc/images/arrow_up.jpg</path>
			<path>./../../_inc/images/arrow_up.png</path>
			<pos>0.97 0.018</pos>
			<maxSize>0.015</maxSize>
			<storyboard repeat="forever">
				<animation property="y" from="0.018" to="0.010" begin="0" duration="700" mode="linear"/>
				<animation property="y" from="0.010" to="0.018" begin="700" duration="700" mode="linear"/>
			</storyboard>
			<origin>0.5 0.5</origin>
		</image>
		<image name="ArrowDown" extra="static">
			<zIndex>175</zIndex>
			<color>666666</color>
			<path>./../../_inc/images/arrow_down.jpg</path>
			<path>./../../_inc/images/arrow_down.png</path>
			<pos>0.991 0.018</pos>
			<maxSize>0.015</maxSize>
			<storyboard repeat="forever">
				<animation property="y" from="0.018" to="0.025" begin="0" duration="700" mode="linear"/>
				<animation property="y" from="0.025" to="0.018" begin="700" duration="700" mode="linear"/>
			</storyboard>
			<origin>0.5 0.5</origin>
		</image>
		<image name="logo">
			<path>./../../_inc/logos/${system.theme}.png</path>
			<path>./../../_inc/logos/${system.theme}-${lang}.png</path>
			<pos>0.5 0.11</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.31 0.1</maxSize>
			<storyboard repeatAt="100">
				<animation property="scale" from="1" to="1.07" begin="100" duration="2000" mode="easeIn"/>
				<animation property="scale" from="1.07" to="1" begin="2100" duration="2000" mode="easeOut"/>
				<animation property="opacity" from="1" to="0.6" begin="100" duration="2000" mode="easeIn"/>
				<animation property="opacity" from="0.6" to="1" begin="2100" duration="2000" mode="easeOut"/>
			</storyboard>
			<zIndex>90</zIndex>
		</image>
		<image name="md_thumbnail">
			<linearSmooth>true</linearSmooth>
			<zIndex>175</zIndex>
			<pos>0.185 0.5</pos>
			<maxSize>0.3 0.45</maxSize>
			<origin>0.5 0.5</origin>
			<delay>0</delay>
			<roundCorners>0</roundCorners>
			<visible>true</visible>
			<storyboard repeatAt="100">
				<animation property="opacity" from="0" to="1" begin="0" duration="100" mode="easeIn"/>
				<animation property="scale" from="1" to="1.07" begin="100" duration="2000" mode="easeOut"/>
				<animation property="scale" from="1.07" to="1" begin="2100" duration="2000" mode="easeIn"/>
			</storyboard>
		</image>
		<image name="fanart">
			<pos>0.5 0.5</pos>
			<color>FFFFFF5F</color>
			<size>1 1</size>
			<zIndex>150</zIndex>
		</image>
		<image name="title_bar" extra="true">
			<pos>0.5 0</pos>
			<size>1 0.18</size>
			<origin>0.5 0</origin>
			<path>./../../_inc/images/space.png</path>
			<color>333333</color>
			<zIndex>85</zIndex>
			<visible>true</visible>
		</image>
		<image name="title_bar2" extra="true">
			<pos>0.5 0.1</pos>
			<size>1 0.04</size>
			<origin>0.5 0</origin>
			<path>./../../_inc/images/space.png</path>
			<color>111111</color>
			<zIndex>90</zIndex>
			<visible>false</visible>
		</image>
		<image name="title_bar3" extra="true">
			<pos>0.5 0.9</pos>
			<size>1 0.04</size>
			<origin>0.5 0.5</origin>
			<path>./../../_inc/images/space.png</path>
			<color>444444</color>
			<zIndex>85</zIndex>
			<visible>true</visible>
		</image>
		<textlist name="gamelist">
			<selectorColor>333333ff</selectorColor>
			<selectedColor>${baseColor}</selectedColor>
			<primaryColor>cccccc</primaryColor>
			<secondaryColor>cccccc</secondaryColor>
			<fontPath>./../../_inc/fonts/Futura-Bold-03.ttf</fontPath>
			<fontSize>0.026</fontSize>
			<pos>0.5 0.205</pos>
			<origin>0.5 0</origin>
			<size>0.86 0.62</size>
			<alignment>center</alignment>
			<lines>14</lines>
			<horizontalMargin>0.01</horizontalMargin>
			<forceUppercase>1</forceUppercase>
			<scrollSound>./../../_inc/sound/scroll.wav</scrollSound>
			<scrollbarColor>333333ff</scrollbarColor>
			<scrollbarCorner>0.49</scrollbarCorner>
			<scrollbarSize>0.005</scrollbarSize>
			<scrollbarAlignment>outerright</scrollbarAlignment>
		</textlist>
		<text name="gamedesc" extra="true">
			<alignment>left</alignment>
			<origin>0.5 0.5</origin>
			<size>0.9 0.06</size>
			<pos>0.5 0.86</pos>
			<color>bebebe</color>
			<fontPath>./../../_inc/fonts/Futura-Medium-01.ttf</fontPath>
			<fontSize>0.021</fontSize>
			<zIndex>140</zIndex>
			<singleLineScroll>yes</singleLineScroll>
			<forceUppercase>1</forceUppercase>
			<text>{game:desc}</text>
			<visible>true</visible>
		</text>
		<text name="players_genre" extra="true">
			<pos>0.05 0.9</pos>
			<origin>0 0.5</origin>
			<alignment>left</alignment>
			<size>0.8 0.04</size>
			<fontPath>./../../_inc/fonts/Futura-Bold-03.ttf</fontPath>
			<fontSize>0.022</fontSize>
			<color>bebebe</color>
			<zIndex>150</zIndex>
			<forceUppercase>1</forceUppercase>
			<text>PLAYERS:   {game:players}   |   GENRE:   {game:genre}</text>
			<visible>true</visible>
		</text>
	</view>
</theme>