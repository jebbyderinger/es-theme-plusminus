			<zIndex>85</zIndex>
			<visible>false</visible>
		</image>
		<image name="players_logo" extra="true">
			<visible>false</visible>
		</image>
		<image name="theflag" extra="true">
			<path>./../../_inc/flags/{game:region}-flag.png</path>
			<maxSize>0.075 0.075</maxSize>
			<pos>0.975 0.136</pos>
			<origin>0.5 0.5</origin>
			<zIndex>120</zIndex>
			<visible>false</visible>
		</image>
		<image name="md_flag">
			<visible>false</visible>
		</image>
		<text name="md_name" extra="true">
			<visible>false</visible>
		</text>
		<text name="md_developer">
			<visible>false</visible>
		</text>
		<text name="md_players">
			<visible>false</visible>
		</text>
		<text name="md_genre">
			<visible>false</visible>
		</text>
		<datetime name="md_releasedate">
			<pos>0.95 0.132</pos>
			<size>0.24 0.08</size>
			<fontSize>0.058</fontSize>
			<lineSpacing>1</lineSpacing>
			<origin>1 0.5</origin>
			<alignment>right</alignment>
			<fontPath>./../../_inc/fonts/EmojiOneColor.otf</fontPath>
			<color>FFFFFF</color>
			<zIndex>120</zIndex>
			<format>%Y</format>
			<visible>false</visible>
		</datetime>
		<image name="developer_logo" extra="true">
			<visible>false</visible>
		</image>
		<image name="genre_logo" extra="true">
			<visible>false</visible>
		</image>
		<rating name="md_rating">
			<visible>false</visible>
		</rating>
		<image name="gametime_logo" extra="true">
			<visible>false</visible>
		</image>
		<image name="md_savestate,md_nosavestate">
			<visible>false</visible>
		</image>
		<image name="md_nosavestate">
			<visible>false</visible>
		</image>
		<image name="md_hidden">
			<visible>false</visible>
		</image>
		<image name="md_kidgame,md_notkidgame">
			<visible>false</visible>
		</image>
		<image name="md_notkidgame"> 
			<visible>true</visible>
		</image>
		<image name="md_cheevos,md_notcheevos">
			<visible>false</visible>
		</image>
		<image name="md_notcheevos">
			<visible>true</visible>
		</image>
		<image name="md_manual,md_nomanual">
			<visible>false</visible>
		</image>
		<image name="md_nomanual">
			<visible>false</visible>
		</image>
		<image if="{system.theme} == 'gb'" name="overlay_gb" extra="true">
			<path>./../../_inc/images/overlay_gb.png</path>
			<size>1 1</size>
			<origin>0.5 0.5</origin>
			<pos>0.5 0.5</pos>
			<zIndex>85</zIndex>
		</image>
		<image if="{system.theme} == 'gbc'" name="overlay_gbc" extra="true">
			<path>./../../_inc/images/overlay_gbc.png</path>
			<size>1 1</size>
			<origin>0.5 0.5</origin>
			<pos>0.5 0.5</pos>
			<zIndex>85</zIndex>
		</image>
		<image if="{system.theme} == 'gba'" name="overlay_gba" extra="true">
			<path>./../../_inc/images/overlay_gba.png</path>
			<size>1 1</size>
			<origin>0.5 0.5</origin>
			<pos>0.5 0.5</pos>
			<zIndex>85</zIndex>
		</image>
		<image if="{system.theme} == 'gamegear'" name="overlay_gamegear" extra="true">
			<path>./../../_inc/images/overlay_gamegear.png</path>
			<size>1 1</size>
			<origin>0.5 0.5</origin>
			<pos>0.5 0.5</pos>
			<zIndex>85</zIndex>
		</image>
		<imagegrid name="gamegrid">
			<pos>0.75 0.0</pos>
			<size>0.25 1</size>
			<scrollDirection>horizontal</scrollDirection>
			<autoLayout>1 1</autoLayout>
			<autoLayoutSelectedZoom>1</autoLayoutSelectedZoom>
			<animateSelection>false</animateSelection>
			<scrollSound>./../../_inc/sound/scroll.wav</scrollSound>
