x<?xml version="1.0" encoding="UTF-8"?>

<theme defaultView="banner">
<formatVersion>7</formatVersion>
	<customView name="minimal" inherits="grid">
		<image name="art" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.5 0.55</pos>
			<minSize>1.1 1</minSize>
			<path>./../../_inc/images/overlayb.png</path>
			<opacity>1</opacity>
			<rotation>180</rotation>
			<zIndex>100</zIndex>
			<visible>true</visible>
		</image>
		<image name="art2" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.5 0.45</pos>
			<minSize>1.1 1</minSize>
			<path>./../../_inc/images/overlayb.png</path>
			<opacity>1</opacity>
			<zIndex>100</zIndex>
			<visible>true</visible>
		</image>
		<image name="art3" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.5 0.5</pos>
			<minSize>1 1</minSize>
			<path>./../../_inc/images/overlay_crt.png</path>
			<opacity>1</opacity>
			<zIndex>100</zIndex>
			<visible>true</visible>
		</image>
<image name="art, art2, art3, logo" extra="true">
    <storyboard event="activate">
        <animation property="opacity" from="1" to="0" begin="2000" duration="1200" mode="easeOut"/>
    </storyboard>
    <storyboard event="deactivate">
        <animation property="opacity" from="0" to="1" duration="1" mode="Linear"/>
    </storyboard>
</image>
		<image name="md_marquee" extra="true">
			<pos>0.5 0.48</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.8 0.58</maxSize>
			<visible>true</visible>
		</image>
		<video name="videocrton2" extra="true">
			<path>./../../_inc/images/CRT_Noise_bak.mp4</path>
			<loops>0</loops>
			<effect>none</effect>
			<origin>0.5 0.5</origin>
			<pos>0.5 0.5</pos>
			<delay>0</delay>
			<pos if="{system.theme} == 'gb'">0.5 0.465</pos>
			<pos if="{system.theme} == 'gamegear'">0.5 0.45</pos>
			<pos if="{system.theme} == 'gbc'">0.5 0.45</pos>
			<delay>0</delay>
			<size>1 1.2</size>
			<size if="{system.theme} == 'gb'">0.5 0.605</size>
			<size if="{system.theme} == 'gamegear'">0.6 0.6</size>
			<size if="{system.theme} == 'gbc'">0.5 0.63</size>
			<size if="{system.theme} == 'gba'">0.74 0.655</size>
			<zIndex>85</zIndex>
			<storyboard event="activate">
				<animation property="opacity" from="1" to="0.2" begin="0" duration="800" mode="easeOut"/>
				<animation property="opacity" from="0.2" to="0" begin="801" duration="300" mode="easeIn"/>
			</storyboard>
            		<storyboard event="deactivate">
				<animation property="opacity" from="0" to="0" begin="0" duration="0"/>
			</storyboard>
		</video>
		<image name="logo" extra="true">
			<path>./../../_inc/logos/${system.theme}.png</path>
			<path>./../../_inc/logos/${system.theme}-${lang}.png</path>
			<pos>0.95 0.91</pos>
			<maxSize>0.214 0.126</maxSize>
			<origin>1 1</origin>
			<zIndex>150</zIndex>
			<visible>true</visible>
			<storyboard>
				<animation property="opacity" from="1" to="0" begin="2000" duration="1500" mode="easeOut"/>
			</storyboard>
			<storyboard event="activate">
				<animation property="opacity" from="1" to="0" begin="2000" duration="1500" mode="easeOut"/>
			</storyboard>
            		<storyboard event="deactivate">
                		<animation property="opacity" from="0" to="1" duration="1" mode="Linear"/>
            		</storyboard>
		</image>
		<image name="md_thumbnail">
			<visible>false</visible>
		</image>
		<image name="title_bar" extra="true">
			<pos>0.5 0.1</pos>
			<size>1 0.04</size>
			<origin>0.5 0</origin>
			<path>./../../_inc/images/space.png</path>
