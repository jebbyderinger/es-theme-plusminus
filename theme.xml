<?xml version="1.0" encoding="UTF-8"?>
<!--
theme name:		plusminus
author:			jebbyderinger
license:		creative commons CC-BY-NC-SA
github:			https://github.com/jebbyderinger/es-theme-plusminus
-->

<theme defaultView="banner">
	<formatVersion>7</formatVersion>

<!-- -->

	<variables>
		<helpSubsetName>Buttons icons</helpSubsetName>
		<helpbuttons>Button</helpbuttons>
		<xboxbuttons>XBOX</xboxbuttons>
		<psxbuttons>PlayStation</psxbuttons>
		<arcadebuttons>Arcade</arcadebuttons>
		<stbuttons>Nintendo</stbuttons>
		<On_Logo>On</On_Logo>
		<Off_Logo>Off</Off_Logo>
	</variables>

<!-- -->
	<include subset="System View Style" name="minimal" displayName="${minimal}">./_inc/systemviews/minimal.xml</include>
	<include subset="System View Style" name="detailed" displayName="${detailed}">./_inc/systemviews/detailed.xml</include>
	<include subset="System View Style" name="detailedplus" displayName="${detailedplus}">./_inc/systemviews/detailedplus.xml</include>
	<include subset="System View Style" name="detailedminus" displayName="${detailedminus}">./_inc/systemviews/detailedminus.xml</include>
	<include subset="System View Style" name="banner" displayName="${banner}">./_inc/systemviews/banner.xml</include>
	
<!-- -->	
	<include subset="System Description" name="description" displayName="${description}">./_inc/systemviews/text_desc.xml</include>
	<include subset="System Description" name="specs" displayName="${specs}">./_inc/systemviews/text_specs.xml</include>
	
	<include subset="System Background" name="system photo" displayName="${system photo}">./_inc/systemviews/background_photo.xml</include>
	<include subset="System Background" name="system video" displayName="${system video}">./_inc/systemviews/background_ad.xml</include>
	<include subset="System Background" name="game video" displayName="${game video}">./_inc/systemviews/background_game.xml</include>

	
<!-- -->

	<include>./_inc/views/basic.xml</include>
	<include>./_inc/views/grid.xml</include>
	<include>./_inc/views/gridvideo.xml</include>
	<include>./_inc/views/minimal.xml</include>
	<include>./_inc/views/detailed.xml</include>
	<include>./_inc/views/detailedplus.xml</include>
	<include>./_inc/views/detailedminus.xml</include>
	<include>./_inc/views/banner.xml</include>
	
	<include subset="gamelist" name="screenshot" displayName="Screenshot" subSetDisplayName="Gamelist Background" appliesTo="detailed, detailedplus, detailedminus, banner, minimal">./_inc/views/background_screenshot.xml</include>
	<include subset="gamelist" name="fanart" displayName="Fan Art" subSetDisplayName="Gamelist Background" appliesTo="detailed, detailedplus, detailedminus, banner, minimal">./_inc/views/background_fanart.xml</include>
	<include subset="gamelist" name="video" displayName="Video" subSetDisplayName="Gamelist Background" appliesTo="detailed, detailedplus, detailedminus, banner, minimal">./_inc/views/background_video.xml</include>
<!-- MENU -->

	<view name="menu">
		<menuText name="menutitle">
			<fontPath>./_inc/fonts/Futura-Bold-03.ttf</fontPath>
			<fontSize>0.028</fontSize>
			<color>FAFAFA</color>
		</menuText>
		<menuText name="menufooter">
			<fontPath>./_inc/fonts/Futura-Medium-01.ttf</fontPath>
			<fontSize>0.024</fontSize>
			<color>777777FF</color>
		</menuText>
		<menuText name="menutext" extra="true" tinyScreen="true">
			<fontPath>./_inc/fonts/Futura-Medium-01.ttf</fontPath>
			<fontSize>0.028</fontSize>
			<color>969696</color>
			<size>0.8 0.8</size>
			<separatorColor>363636FF</separatorColor>
			<selectorColor>${baseColor}</selectorColor>
			<selectorColorEnd>${gradientEndColor}</selectorColorEnd>
			<selectedColor>FFFFFF</selectedColor>
			<selectorGradientType>horizontal</selectorGradientType>
		</menuText>
		<menuTextSmall name="menutextsmall" extra="true" tinyScreen="true">
			<fontPath>./_inc/fonts/Futura-Bold-03.ttf</fontPath>
			<fontSize>0.02</fontSize>
			<color>deec00</color>
		</menuTextSmall>
		<menuBackground name="menubg">
			<color>202020</color>
			<path>./_inc/images/frame.png</path>
		</menuBackground>
		<menuIcons name="menuicons">
			<iconKodi>./_inc/icons/Kodi.png</iconKodi>
			<iconSystem>./_inc/icons/System.png</iconSystem>
			<iconUpdates>./_inc/icons/Updates.png</iconUpdates>
			<iconGames>./_inc/icons/Games.png</iconGames>
			<iconControllers>./_inc/icons/Controllers.png</iconControllers>
			<iconUI>./_inc/icons/UI.png</iconUI>
			<iconSound>./_inc/icons/Sound.png</iconSound>
			<iconNetwork>./_inc/icons/Network.png</iconNetwork>
			<iconScraper>./_inc/icons/Scraper.png</iconScraper>
			<iconAdvanced>./_inc/icons/Advanced.png</iconAdvanced>
			<iconQuit>./_inc/icons/Quit.png</iconQuit>
			<iconRestart>./_inc/icons/Restart.png</iconRestart>
			<iconShutdown>./_inc/icons/Shutdown.png</iconShutdown>
			<iconFastShutdown>./_inc/icons/Fastshutdown.png</iconFastShutdown>
			<iconRetroachievements>./_inc/icons/Contest.png</iconRetroachievements>
			<iconManual>./_inc/icons/Manual.png</iconManual>
		</menuIcons>
		<menuTextEdit name="menutextedit">
			<inactive>./_inc/images/textinput_ninepatch.png</inactive>
			<active>./_inc/images/textinput_ninepatch_active.png</active>
		</menuTextEdit>
	</view>

	<view name="screen">
		<text name="clock">
			<color>bebebe</color>
			<fontSize>0.022</fontSize>
			<itemSpacing>0.01</itemSpacing>
			<pos>0.05 0.08</pos>
			<size>0.11 0.04</size>
			<origin>0 0.5</origin>
			<alignment>left</alignment>
			<fontPath>./_inc/fonts/Futura-Bold-03.ttf</fontPath>
			<visible>false</visible>
		</text>
		<batteryIndicator name="batteryIndicator">
			<pos>0.936 0.928</pos>
			<size>0.035 0.035</size>
			<itemSpacing>0.01</itemSpacing>
			<horizontalAlignment>right</horizontalAlignment>
			<incharge>./_inc/images/battery/incharge.svg</incharge>
			<full>./_inc/images/battery/full.svg</full>
			<at75>./_inc/images/battery/75.svg</at75>
			<at50>./_inc/images/battery/50.svg</at50>
			<at25>./_inc/images/battery/25.svg</at25>
			<empty>./_inc/images/battery/empty.svg</empty>
			<fontPath>./_inc/fonts/Futura-Medium-01.ttf</fontPath>
			<fontSize>0.022</fontSize>
			<color>FFFFFF</color>
			<visible>false</visible>
		</batteryIndicator>
	</view>
	<view name="system">
		<carousel name="systemcarousel">
			<color>00000000</color>
			<scrollSound>./_inc/sound/scroll.wav</scrollSound>
			<defaultTransition>instant</defaultTransition>
		</carousel>
		<text name="logoText">
			<fontPath>./_inc/fonts/Futura-Medium-01.ttf</fontPath>
			<color>${baseColor}</color>
			<forceUppercase>true</forceUppercase>
		</text>
		<sound name="bgsound">
			<path>./_inc/music/${system.theme}.ogg</path>
			<path>./_inc/music/${system.theme}.wav</path>
			<path>./_inc/music/${system.theme}.mp3</path>
		</sound>
	</view>
		<view name="basic,detailed,grid,gridvideo,detailedplus,detailedminus,banner,minimal">
		<image name="logo">
			<path>./_inc/logos/${system.theme}.png</path>
			<path>./_inc/logos/${system.theme}.svg</path>
			<path>./_inc/logos/${system.theme}-w.svg</path>
			<path>./_inc/logos/${system.theme}-w-${lang}.png</path>
			<path>./_inc/logos/${system.theme}-w-${lang}.svg</path>
			<path>./_inc/logos/${system.theme}-${lang}.png</path>
			<path>./_inc/logos/${system.theme}-${lang}.svg</path>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="logo" region="eu"></image>
		<image name="logo" region="us">
			<path>./_inc/logos/us/${system.theme}.png</path>
			<path>./_inc/logos/us/${system.theme}.svg</path>
			<path>./_inc/logos/us/${system.theme}-w.svg</path>
		</image>
		<image name="logo" region="jp">
		  <path>./_inc/logos/jp/${system.theme}.png</path>
			<path>./_inc/logos/jp/${system.theme}.svg</path>
			<path>./_inc/logos/jp/${system.theme}-w.svg</path>
		</image>
	</view>

<!--  -->
	<subset name="helpsystem" displayName="${helpSubsetName}">
		<include name="buttons" displayName="${helpbuttons}">./_inc/help/buttons.xml</include>
		<include name="xboxbuttons" displayName="${xboxbuttons}">./_inc/help/xboxbuttons.xml</include>
		<include name="psxbuttons" displayName="${psxbuttons}">./_inc/help/psxbuttons.xml</include>
		<include name="arcadebuttons" displayName="${arcadebuttons}">./_inc/help/arcadebuttons.xml</include>
		<include name="standard" displayName="${stbuttons}">./_inc/help/default.xml</include>
	</subset>

<customView name="detailed, grid. gridvideo, detailedminus, detailedplus, minimal, basic, banner">
		<image name="gametime_logo,genre_logo,developer_logo,playcount_logo,publisher_logo,release_date_logo,md_kidgame,md_notkidgame,md_hidden,md_savestate,md_nosavestate,md_cheevos,md_notcheevos,md_manual,md_nomanual,md_flag,players_logo">
		</image>
		<image name="logo">
		</image>
		<text name="md_gametime,md_genre,md_developer,md_playcount,md_publisher,md_players">
		</text>
		<datetime name="md_lastplayed,md_releasedate">
		</datetime>
		<rating name="md_rating">
			<unfilledColor>282828FF</unfilledColor>
		</rating>
</customView>

</theme>
